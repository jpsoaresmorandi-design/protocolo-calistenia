{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/vsl",
      "destination": "/vsl.html"
    },
    {
      "source": "/tsl",
      "destination": "/tsl.html"
    },
    {
      "source": "/quiz",
      "destination": "/index.html"
    }
  ]
}
