{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/vsl$",
      "dest": "/vsl.html"
    },
    {
      "src": "^/quiz$",
      "dest": "/index.html"
    },
    {
      "src": "^/app/?$",
      "dest": "/app/index.html"
    },
    {
      "src": "^/app/(.*)",
      "dest": "/app/$1"
    },
    {
      "src": "^/(.*)",
      "dest": "/$1"
    }
  ]
}

